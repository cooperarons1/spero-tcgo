# Exclude ALL of data/ then whitelist only the runtime files the server
# reads. Previous list-based exclusions kept missing huge files
# (sim-history-*.jsonl at 100 GB each, alt neural-eval weights, etc.).
data/**
!data/cards.json
!data/cardArtMap.json
!data/ai-weights.json
!data/neural-eval-weights.json
!data/animation-weights.json
!data/animation-weights-rank.json
